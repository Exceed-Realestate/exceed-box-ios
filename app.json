{
  "expo": {
    "name": "Exceed Box",
    "slug": "exceed-box",
    "owner": "spicykiwi",
    "version": "1.0.0",
    "scheme": "exceedbox",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F5F7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exceedre.box",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Exceed Box uses the camera to scan business cards onto a lead.",
        "NSPhotoLibraryUsageDescription": "Exceed Box lets you attach a business-card photo from your library.",
        "NSMicrophoneUsageDescription": "Exceed Box uses the microphone to record a voice memo on a lead."
      },
      "buildNumber": "8"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "545268e4-47ca-4a85-92c4-90e4825e24ad"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5F7"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Exceed Box uses the microphone to record a voice memo on a lead."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Exceed Box uses the camera to scan business cards onto a lead.",
          "photosPermission": "Exceed Box lets you attach a business-card photo from your library."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FFD84D"
        }
      ],
      "expo-web-browser",
      "./plugins/withKeyCommand"
    ],
    "android": {
      "package": "com.exceedre.box",
      "adaptiveIcon": {
        "backgroundColor": "#15171c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/545268e4-47ca-4a85-92c4-90e4825e24ad"
    }
  }
}